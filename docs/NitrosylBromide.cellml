<?xml version='1.0' encoding='UTF-8'?>
<model name="NOBr" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#" xmlns:cmeta="http://www.cellml.org/metadata/1.0#">
    <units name="M">
        <unit units="mole"/>
        <unit exponent="-1" units="litre"/>
    </units>
    <units name="M_per_sec">
        <unit units="M"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_sec_per_M2">
        <unit exponent="-1" units="second"/>
        <unit exponent="-2" units="M"/>
    </units>
    <units name="per_sec_per_M">
        <unit exponent="-1" units="second"/>
        <unit exponent="-1" units="M"/>
    </units>
    <component name="reaction_rate">
        <variable cmeta:id="va_NO-N.O_eq1.l_sv" initial_value="1" name="x_NO" units="M"/>
        <variable cmeta:id="va_36889_eq1.r" initial_value="1" name="x_Br2" units="M"/>
        <variable cmeta:id="va_NOBR-N.O.Br_eq1.r" initial_value="0" name="x_NOBr" units="M"/>
        <variable name="t" units="second"/>
        <variable cmeta:id="co_NO_1" initial_value="-2" name="NO_r1" units="dimensionless"/>
        <variable cmeta:id="co_36889_1" initial_value="-1" name="Br2_r1" units="dimensionless"/>
        <variable cmeta:id="co_NOBR_1" initial_value="2" name="NOBr_r1" units="dimensionless"/>
        <variable cmeta:id="rc_f_1" initial_value="0.42" name="k_f" units="per_sec_per_M2"/>
        <variable cmeta:id="rc_r_1" initial_value="0.17" name="k_r" units="per_sec_per_M"/>
        <variable cmeta:id="ra_1" name="v_1" units="M"/>
        <!--var{bc_36889_i.1} bc_1: M_per_sec {init: 0.05};-->
        <variable cmeta:id="bc_36889_i.2" name="bc_2" units="M_per_sec"/>
        <!--var{bc_36889_o.3} bc_3: M_per_sec;-->
        <variable cmeta:id="bv_36889_3" initial_value="2" name="k4" units="M_per_sec"/>
        <variable cmeta:id="bc_36889_i.4" name="bc_4" units="M_per_sec"/>
        <variable cmeta:id="en_Rad3_1" initial_value="-1" name="Rad3_en1" units="dimensionless"/>
        <!--var{va_Rad3} Rad3: dimensionless {init: 0};
var{bc_Rad3_o.1} V_2: M;
var{bc_Rad3_i.2} V_3: M;-->
        <variable cmeta:id="bv_Rad3_1" initial_value="1" name="k2" units="M"/>
        <variable cmeta:id="bv_Rad3_2" initial_value="2" name="k3" units="M"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_1</ci>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>k_f</ci>
                        <apply>
                            <power/>
                            <ci>x_NO</ci>
                            <apply>
                                <abs/>
                                <ci>NO_r1</ci>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <ci>x_Br2</ci>
                            <apply>
                                <abs/>
                                <ci>Br2_r1</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_r</ci>
                        <apply>
                            <power/>
                            <ci>x_NOBr</ci>
                            <apply>
                                <abs/>
                                <ci>NOBr_r1</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_NO</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>NO_r1</ci>
                    <ci>v_1</ci>
                </apply>
            </apply>
            <!--+v_2+v_4;-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_Br2</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>Br2_r1</ci>
                    <ci>v_1</ci>
                </apply>
            </apply>
            <!--+v_3+v_5;-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x_NOBr</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>NOBr_r1</ci>
                    <ci>v_1</ci>
                </apply>
            </apply>
        </math>
        <!-- +v_6;-->
    </component>
</model>
